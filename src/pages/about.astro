---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="About — Payment Rules Monitor">
  <h1>About</h1>

  <p>
    Payment Rules Monitor tracks policy and rule changes from major payment
    platforms that affect how online businesses receive money.
  </p>
</BaseLayout>
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>About — Payment Rules Monitor</title>
  </head>
  <body>
    <main style="max-width:720px;margin:4rem auto;font-family:system-ui;">
      <h1>About</h1>
      <p>
        Payment Rules Monitor tracks policy and rule changes from major payment
        platforms that affect how online businesses receive money.
      </p>
      <p>
        Platforms update terms frequently. Enforcement is often silent.
        This service exists to surface those changes early.
      </p>
    </main>
  </body>
</html>
